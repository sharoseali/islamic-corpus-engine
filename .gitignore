# Python Virtual Environments (any name; qlib/ is the one on the original dev PC)
venv/
.venv/
qlib/

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/

# Environment
.env

# IDE
.idea/
.vscode/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/
*.egg-info/

# Local Database (if used)
*.sqlite3

# Raw downloaded corpus artifacts (~300M). Reproducible from the pinned
# sources in app/pipelines/, and their SHA-256 checksums are preserved in
# corpus/manifests/ (which IS committed), so provenance stays verifiable
# without carrying the bulk in git. The .gitkeep placeholders remain tracked
# so the directory layout is restored on a fresh clone.
corpus/original/
corpus/temp/
corpus/cache/

# Release bundles (database dump + models), built by scripts/release_bundle.sh
release/
