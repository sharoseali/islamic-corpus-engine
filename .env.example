# Islamic Knowledge Core - environment template
# Copy to .env and fill in real values. NEVER commit .env.

# --- PostgreSQL (docker-compose service: db) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=islamic_corpus
POSTGRES_USER=ice_admin
POSTGRES_PASSWORD=change-me

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Search models (see docs/RUNNING.md) ---
# EMBEDDING_DEVICE=auto          # auto | cuda | cpu
# EMBEDDING_THREADS=16
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
# RERANKER_MODEL_DIR=            # plain model dir under corpus/cache/models
# RERANKER_DEVICE=cpu            # cpu | cuda
# RERANK_CANDIDATES=24           # candidates the reranker re-orders per query
# CORS_ORIGINS=http://localhost:3400,http://127.0.0.1:3400

# --- Voice search ---
# WHISPER_MODEL=small
