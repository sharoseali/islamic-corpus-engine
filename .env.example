# Islamic Knowledge Core — environment template
# Copy to .env and fill in real values. NEVER commit .env.

# --- PostgreSQL (docker-compose service: db) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=islamic_corpus
POSTGRES_USER=ice_admin
POSTGRES_PASSWORD=change-me

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
