# Elaaj behind an existing nginx (the server already terminates TLS and
# serves other sites). The Elaaj stack publishes Caddy on 127.0.0.1:8090
# only (HTTP_PORT in .env). Copy to /etc/nginx/sites-available/elaaj,
# link into sites-enabled, `nginx -t`, `systemctl reload nginx`.
#
# With a domain: set server_name, then `certbot --nginx -d elaaj.example.com`.
# Without one: `listen 80 default_server;` answers requests to the bare IP.

server {
    listen 80;
    server_name elaaj.example.com;

    client_max_body_size 25m;          # voice search uploads

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;       # CPU reranker can take several seconds
    }
}
