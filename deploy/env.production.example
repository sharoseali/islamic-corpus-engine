# Elaaj production environment. Copy to .env in the repository root on the
# server (docker compose and the API both read it). Never commit .env.

# --- PostgreSQL (internal to the stack) ---
POSTGRES_DB=islamic_corpus
POSTGRES_USER=ice_admin
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Application ---
APP_ENV=production
LOG_LEVEL=INFO
# uvicorn worker processes. Each loads its own copy of the search models
# (about 3 GB of RAM per worker); raise only on a large server.
API_WORKERS=1
# Host user that owns the checkout (corpus/ must be writable by it).
APP_UID=1000
APP_GID=1000

# --- Web ---
# Domain name for automatic HTTPS, e.g. elaaj.example.com (DNS must point
# at this server first). ":80" serves plain HTTP on the bare IP address.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL memory (for a 16 GB server; scale with RAM) ---
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_MAINTENANCE_WORK_MEM=1GB
PG_SHM_SIZE=1gb
PG_PARALLEL_WORKERS=2

# --- Search models (CPU server) ---
EMBEDDING_DEVICE=cpu
# onnxruntime threads: the number of CPU cores
EMBEDDING_THREADS=4
# Reranker: full precision (same rankings as the GPU build) or none.
# Measured per-query times are in docs/DEPLOYMENT.md.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_DIR=bge-reranker-v2-m3-fp32
RERANKER_DEVICE=cpu
RERANK_CANDIDATES=12

# --- Voice search (offline Whisper, downloads about 480 MB on first use
# unless pre-seeded by the release bundle) ---
WHISPER_MODEL=small
